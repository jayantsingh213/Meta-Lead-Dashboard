# ─────────────────────────────────────────────────────────────
# Meta Lead Ads Backend – Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Server
PORT=3000

# Meta / Facebook
# Long-lived Page Access Token from Meta Developer Console
META_ACCESS_TOKEN=your_meta_page_access_token_here

# A random secret string you choose – used to verify webhook ownership
META_VERIFY_TOKEN=your_random_verify_token_here

# Your Facebook Page ID (numeric)
META_PAGE_ID=your_page_id_here

# App Secret from App Dashboard → Settings → Basic
META_APP_SECRET=your_app_secret_here

# MongoDB
# Local:   mongodb://127.0.0.1:27017/meta_leads
# Atlas:   mongodb+srv://user:pass@cluster.mongodb.net/meta_leads
MONGODB_URI=mongodb://127.0.0.1:27017/meta_leads
